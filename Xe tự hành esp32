// ================= CHƯƠNG TRÌNH CHÍNH =================

void loop() {
  float truoc = doKhoangCach();
  khoangCachTruoc = truoc;

  static unsigned long lastLogTien = 0; 

  if (truoc > KHOANG_DUNG) {
    capNhatTrangThai("Đang tiến thẳng (Thoáng)", "ĐANG TIẾN THẲNG", "bg-tien", "TIEN");
    chay(TOC_DO, TOC_DO);
    
    if (millis() - lastLogTien > 400) {
      ghiLichSu(truoc, 0.00, 0.00, "Tiến thẳng");
      lastLogTien = millis();
    }
    
    delay(40);
    return;
  }

  // ================= PHÁT HIỆN VẬT CẢN =================
  chay(0, 0);
  capNhatTrangThai("Phát hiện vật cản <= 30cm", "DỪNG & LÙI LẠI", "bg-lui", "LUI");
  // Cập nhật lại in log Serial sang 2 chữ số thập phân
  Serial.printf("\nVat can phia truoc: %.2f cm", truoc);
  delay(500); 

  chay(-TOC_DO, -TOC_DO);
  capNhatTrangThai("Đang lùi tạo không gian", "ĐANG LÙI LẠI", "bg-lui", "LUI");
  delay(300);

  chay(0, 0);
  delay(150);

  capNhatTrangThai("Đang quét hai bên", "ĐANG QUÉT 2 BÊN", "bg-re", "TRAI"); 
  
  float phai = nhin(GOC_PHAI);
  float trai = nhin(GOC_TRAI);
  khoangCachPhai = phai;
  khoangCachTrai = trai;

  datGoc(GOC_THANG);
  Serial.printf("\nQuet hai ben: Phai %.2f cm | Trai %.2f cm", phai, trai);

  String huongChon = "";

  if (phai < KHOANG_DUNG && trai < KHOANG_DUNG) {
    if (phai >= trai) {
      capNhatTrangThai("Ngõ cụt -> Quay đầu phải", "XE QUAY ĐẦU (PHẢI)", "bg-quay", "QUAY_DAU");
      huongChon = "Quay đầu (Phải)";
      rePhai(THOI_GIAN_QUAY_DAU);
    } else {
      capNhatTrangThai("Ngõ cụt -> Quay đầu trái", "XE QUAY ĐẦU (TRÁI)", "bg-quay", "QUAY_DAU");
      huongChon = "Quay đầu (Trái)";
      reTrai(THOI_GIAN_QUAY_DAU);
    }
  }
  else if (phai >= trai) {
    capNhatTrangThai("Bên phải rộng hơn -> Rẽ phải", "RẼ PHẢI", "bg-re", "PHAI");
    huongChon = "Rẽ Phải";
    rePhai(THOI_GIAN_RE);
  }
  else {
    capNhatTrangThai("Bên trái rộng hơn -> Rẽ trái", "RẼ TRÁI", "bg-re", "TRAI");
    huongChon = "Rẽ Trái";
    reTrai(THOI_GIAN_RE);
  }

  ghiLichSu(truoc, trai, phai, huongChon);

  chay(0, 0);
  capNhatTrangThai("Ổn định, chuẩn bị chạy tiếp", "ĐANG TIẾN THẲNG", "bg-tien", "TIEN");
  delay(400);
}
