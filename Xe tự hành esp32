/*
  PYWORLD.VN - Xe robot tự tránh vật cản
  ESP32 + HC-SR04 + Servo + L298N
  (Web AJAX - Đa Nhiệm 2 Nhân - Log 50 Dòng - Số thực 2 chữ số thập phân)
*/

#include <WiFi.h>

#define TRIG_PIN 18
#define ECHO_PIN 19
#define SERVO_PIN 23

#define ENA 27
#define IN1 26
#define IN2 25

#define ENB 13
#define IN3 33
#define IN4 32

const int KHOANG_DUNG = 30;

const int TOC_DO = 40;
const int TOC_DO_QUAY = 75;

const int GOC_THANG = 90;
const int GOC_PHAI = 20;
const int GOC_TRAI = 160;

const int THOI_GIAN_RE = 550;
const int THOI_GIAN_QUAY_DAU = 900;

WiFiServer server(80);
TaskHandle_t WebServerTask;

// Biến trạng thái toàn cục
String trangThaiHienTai = "Đang khởi động...";
String hanhDongTiepTheo = "ĐANG CHUẨN BỊ";
String cssTrangThai = "bg-tien";
String activeBtn = "TIEN";

float khoangCachTruoc = 0.00;
float khoangCachPhai = 0.00;
float khoangCachTrai = 0.00;

struct LogItem {
  float truoc;
  float trai;
  float phai;
  String huongDi;
};

// Lưu 50 dòng lịch sử xử lý
const int MAX_LOG = 50; 
LogItem historyList[MAX_LOG];
int logCount = 0;

void ghiLichSu(float t, float l, float r, String h) {
  for (int i = MAX_LOG - 1; i > 0; i--) {
    historyList[i] = historyList[i - 1];
  }
  historyList[0] = {t, l, r, h};
  if (logCount < MAX_LOG) logCount++;
}

void capNhatTrangThai(String tt, String hanhDong, String css, String btn) {
  trangThaiHienTai = tt;
  hanhDongTiepTheo = hanhDong;
  cssTrangThai = css;
  activeBtn = btn;
}

// ================= ĐIỀU KHIỂN ĐỘNG CƠ & SERVO =================

void banh(int chanEN, int chanA, int chanB, int v) {
  v = constrain(v, -100, 100);
  digitalWrite(chanA, v > 0 ? HIGH : LOW);
  digitalWrite(chanB, v < 0 ? HIGH : LOW);
  ledcWrite(chanEN, (uint32_t)abs(v) * 1023 / 100);
}

void chay(int trai, int phai) {
  banh(ENA, IN1, IN2, trai);
  banh(ENB, IN3, IN4, phai);
}

void rePhai(int thoiGian) {
  chay(0, 0); delay(100);
  chay(TOC_DO_QUAY, -TOC_DO_QUAY); delay(thoiGian);
  chay(0, 0); delay(150);
}

void reTrai(int thoiGian) {
  chay(0, 0); delay(100);
  chay(-TOC_DO_QUAY, TOC_DO_QUAY); delay(thoiGian);
  chay(0, 0); delay(150);
}

void datGoc(int goc) {
  uint32_t us = 500 + 1900UL * constrain(goc, 0, 180) / 180;
  ledcWrite(SERVO_PIN, (uint32_t)((uint64_t)us * 65536 / 20000));
}

float doMotLan() {
  digitalWrite(TRIG_PIN, LOW); delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH); delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  unsigned long t = pulseIn(ECHO_PIN, HIGH, 30000);
  return (t == 0) ? 400.00 : t / 58.0;
}

float doKhoangCach() {
  float a = doMotLan(); delay(15);
  float b = doMotLan(); delay(15);
  float c = doMotLan();
  return max(min(a, b), min(max(a, b), c));
}

float nhin(int goc) {
  datGoc(goc);
  delay(300);
  return doKhoangCach();
}

// ================= KHỞI ĐỘNG =================

void setup() {
  Serial.begin(115200);

  WiFi.softAP("ESP32_Robot_Car", "12345678"); 
  server.begin();

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  int chan[] = {IN1, IN2, IN3, IN4};
  for (int p : chan) { pinMode(p, OUTPUT); }

  ledcAttach(ENA, 1000, 10);
  ledcAttach(ENB, 1000, 10);
  ledcAttach(SERVO_PIN, 50, 16);

  datGoc(GOC_THANG);
  chay(0, 0);
  
  xTaskCreatePinnedToCore(
    XuLyWebServer, 
    "WebServer",   
    10000,         
    NULL,          
    1,             
    &WebServerTask,
    0              
  );

  delay(2000);
}

// ================= TÁC VỤ XỬ LÝ WEB =================
